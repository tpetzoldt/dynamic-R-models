## foo

::: {.column width="67%"}

```{webr-r}
#|  context: interactive
#|  autorun: false
#|  label: lotka-volterra
#|  fig-height: 2.5
#|  fig-width: 7

library("deSolve")
par(mar=c(4, 4, 1, 1), las = 1)

model <- function(t, y, parms) {
  with(as.list(c(y, parms)), {
    dN <- r * N
    list(c(dN))
  })
}

y0    <- c(N = 1)
parms <- c(r = 0.1)
yout  <- as.data.frame(ode(y = y0, times = 0:50, func = model, parms = parms))
plot(yout$time, yout$N, type = "l", col = "forestgreen")

```
:::

